<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="식품 스캔"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- 사용 가이드 다시 보기 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guide"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❔ 사용법"
                android:textColor="@color/green_dark" />
        </LinearLayout>

        <!-- 촬영 모드: 식재료 / 가격표 / 영수증 / 소비기한 -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:checkedButton="@+id/btn_mode_food"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_food"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:paddingHorizontal="4dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="식재료" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_price"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:paddingHorizontal="4dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="가격표" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_receipt"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:paddingHorizontal="4dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="영수증" />

            <!-- 포장지의 소비기한 날짜와 식품명을 차례로 찍어 채운다 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_expiry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:paddingHorizontal="4dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="소비기한" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/text_primary"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 권한 없음 / 모드 안내 -->
            <TextView
                android:id="@+id/tv_camera_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="화면을 눌러 초점을 맞추세요"
                android:textColor="@color/green_dark"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_flash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_emoji"
                android:contentDescription="플래시"
                android:src="@drawable/ic_flash"
                android:visibility="gone"
                app:tint="@color/text_secondary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_capture"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                android:text="📷 촬영해서 인식하기"
                android:textColor="@color/green_dark"
                app:cornerRadius="16dp"
                app:strokeColor="@color/green" />

            <!-- 저장된 사진으로 인식(테스트·갤러리) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="🖼 사진"
                android:textColor="@color/green_dark"
                app:cornerRadius="16dp"
                app:strokeColor="@color/green" />
        </LinearLayout>

        <!-- 소비기한 모드: ① 날짜 → ② 식품명 두 번 촬영. 식품명은 건너뛰고 직접 입력할 수 있다 -->
        <LinearLayout
            android:id="@+id/row_expiry_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_expiry_step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_expiry_redo"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="날짜 다시"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_expiry_skip"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="이름 직접 입력"
                android:textColor="@color/green_dark" />
        </LinearLayout>

        <!-- 식재료 모드: 자주 사는 품목 빠른 선택(사진 인식이 없거나 틀렸을 때) -->
        <HorizontalScrollView
            android:id="@+id/scroll_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_quick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- 사진 분류·가격표 후보(추정). 누르면 식품명에 들어간다 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips_candidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:singleSelection="true" />

        <!-- 인식 결과 안내(추정) -->
        <TextView
            android:id="@+id/tv_scan_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            style="@style/SaveFood.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="인식된 식품 정보"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="식품명">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/SaveFood.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="식약처 권장 기한 기준으로 자동 설정됨" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="2"
                    android:hint="소비기한">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_expiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="수량">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_quantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/SaveFood.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="보관 상태" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_good"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="양호" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_aging"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="숙성 중" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_warn"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="주의" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                style="@style/SaveFood.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="보관 장소" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:checkedButton="@+id/btn_loc_fridge"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_loc_fridge"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="냉장실" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_loc_freezer"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="냉동실" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_loc_room"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="실온" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register"
            style="@style/Widget.SaveFood.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="＋ 냉장고에 등록" />
    </LinearLayout>
</ScrollView>
